MONGODB_URI=<add your MongoDB connection string here>
PORT=4000
NODE_ENV=development

# ---- Email delivery ---------------------------------------------------------
# One-time sign-up, sign-in, and password-reset codes are delivered as follows:
#   1. In development, the console transport is the DEFAULT. Every code is
#      printed in the API terminal. No mailbox or SMTP account is needed.
#   2. Set EMAIL_PROVIDER=resend or EMAIL_PROVIDER=smtp to test a real provider
#      in development.
#   3. In production, configure Resend or SMTP; codes are never written to logs.
# Choose explicitly with EMAIL_PROVIDER=resend|smtp|console. Invalid values fail.
EMAIL_PROVIDER=
EMAIL_FROM=LeadAI <no-reply@example.com>

# Preferred provider. Get a key at https://resend.com/api-keys and verify the
# sending domain/address used in EMAIL_FROM. Never commit the key.
RESEND_API_KEY=<add your Resend API key here>

# SMTP fallback for installations that have not moved to Resend. Works with any
# SMTP provider (Gmail app password, Mailtrap, SendGrid, Postmark, Brevo, ...).
# SMTP_PASS is your provider's app password. Never commit it.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- OpenRouter AI ----------------------------------------------------------
# Get your API key from https://openrouter.ai/keys and paste it here.
# Without a key, the Copilot uses the local deterministic planner.
OPENROUTER_API_KEY=
# Model used for Copilot chat and AI board planning. For a specific model, use
# its OpenRouter ID (for example anthropic/claude-sonnet-4).
OPENROUTER_MODEL=openrouter/free
