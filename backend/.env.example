MONGODB_URI=<add your MongoDB connection string here>
PORT=4000
NODE_ENV=development

# Frontend URL used to build signup verification links.
# Development default when unset: http://localhost:5173
# Production falls back to the host that served the request.
APP_URL=http://localhost:5173

# Email delivery for sign-up verification links, sign-in from a new browser
# and password reset codes. Works with any SMTP provider (Gmail app password,
# Mailtrap, SendGrid, Postmark, Brevo, ...).
# Without SMTP_HOST the API prints links/codes to its console in development;
# in production email is required and the flow fails with a clear error.
# SMTP_PASS is where your provider's app password goes. Never commit it.
SMTP_HOST=<add your SMTP host here>
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587).
SMTP_SECURE=false
SMTP_USER=<add your SMTP username here>
SMTP_PASS=<add your SMTP password here>
SMTP_FROM=LeadAI <no-reply@example.com>

# OpenRouter AI integration for Copilot chat.
# Get your API key from https://openrouter.ai/keys and paste it here.
OPENROUTER_API_KEY=<add your OpenRouter API key here>
# Model to use for the Copilot chat. Choose from OpenRouter's catalog or a specific model.
OPENROUTER_MODEL=openrouter/free