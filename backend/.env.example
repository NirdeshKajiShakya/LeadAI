# Shared development database (MongoDB Atlas).
# One database for the whole team: everyone pulls code from Git, then connects here.
# Each developer should use their own Atlas database user; never commit real credentials.
# MONGODB_URI=mongodb+srv://leadai-dev-<your-name>:<password>@<cluster>.mongodb.net/leadai_dev?retryWrites=true&w=majority&appName=leadai-dev

# Local MongoDB alternative (private to this machine, useful for solo work).
MONGODB_URI=mongodb://127.0.0.1:27017/leadai_dev

PORT=4000
NODE_ENV=development

# Offline-only escape hatch: keeps data in RAM. Lost on restart, never shared, never for
# team work. Leave false so a missing/broken connection fails loudly instead.
ALLOW_MEMORY_DB=false

# OpenRouter AI integration for Copilot chat.
# Get your API key from https://openrouter.ai/keys and paste it here.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Model to use for the Copilot chat. Choose from OpenRouter's catalog or a specific model.
OPENROUTER_MODEL=cohere/north-mini-code:free
# In test mode only, reset requests include the one-time token in the response.
# Configure an email provider before enabling password resets in production.
