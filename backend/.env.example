PORT=4000
NODE_ENV=development

# MongoDB connection string.
# Tiered fallback: user Settings override > this .env value > mongodb://localhost:27017/leadai
MONGODB_URI=mongodb://localhost:27017/leadai

# OpenRouter AI integration for Copilot chat.
# Get your API key from https://openrouter.ai/keys
# Tiered fallback: user Settings override > this .env value > (AI disabled with graceful message)
OPENROUTER_API_KEY=<add your OpenRouter API key here>
OPENROUTER_MODEL=openrouter/free

# In test mode only, reset requests include the one-time token in the response.
# Configure an email provider before enabling password resets in production.
